# ── Build output ──────────────────────────────────────────────────────────────
build/
dist/

# ── Python ────────────────────────────────────────────────────────────────────
venv311/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Patient session data (privacy — never commit) ─────────────────────────────
data/*
!data/sessions/
data/sessions/*
!data/sessions/.gitkeep

# ── IDE & local tooling ───────────────────────────────────────────────────────
.idea/
.vscode/
.claude/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Old / scratch model exports (kept locally, not versioned) ─────────────────
files/models/old/

# ── Pictures: ship only the logos the app actually uses ───────────────────────
files/pictures/*
!files/pictures/logo.png
!files/pictures/logo.ico
!files/pictures/HD Logo.png
